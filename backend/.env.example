# Server bind address. Examples: 0.0.0.0|127.0.0.1|localhost
HOST=0.0.0.0

# Server port. Examples: 8000|8080|3000
PORT=8000

# Whisper model name. Common options: tiny|base|small|medium|large-v1|large-v2|large-v3|distil-large-v3
WHISPER_MODEL=base

# Inference device. Common options: cpu|cuda|auto. Enable `cuda` only after following docs/GPU_SETUP.md.
WHISPER_DEVICE=cpu

# Compute type. Common options: auto|default|int8|int8_float16|int8_float32|float16|float32
WHISPER_COMPUTE_TYPE=int8

# Preload the model during app startup. Accepted truthy/falsy values: true|false|1|0|yes|no|on|off
WHISPER_LOAD_ON_STARTUP=true
