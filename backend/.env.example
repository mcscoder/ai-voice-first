# Server bind address. Examples: 0.0.0.0|127.0.0.1|localhost
HOST=0.0.0.0

# Server port. Examples: 8000|8080|3000
PORT=8000

# Model precision. Common options: fp32|int8
ASR_PRECISION=fp32

# Number of inference threads.
ASR_NUM_THREADS=4

# Preload model during startup. Accepted truthy/falsy values: true|false|1|0|yes|no|on|off
ASR_LOAD_ON_STARTUP=true

# Assistant provider settings.
# The API key must stay in backend/.env and never in Flutter assets.
ASSISTANT_API_BASE_URL=http://127.0.0.1:8317/v1
ASSISTANT_API_KEY=replace-me
ASSISTANT_MODEL=gemini-2.5-flash-lite
ASSISTANT_PROVIDER_TIMEOUT_SECONDS=30
ASSISTANT_SYSTEM_PROMPT=You are a helpful voice assistant. Reply in {language_name}. Keep answers concise, natural, and useful. Do not mention transcripts or internal processing.

# Local knowledge-brain storage. Defaults to backend/.data/knowledge-brain.sqlite3.
KNOWLEDGE_BRAIN_DB_PATH=

# Default personality used by the assistant when no user-specific setting exists.
ASSISTANT_PERSONALITY=serious

# Optional memory persistence after assistant responses.
ASSISTANT_STORE_MEMORIES=true

# Optional memory retrieval before each assistant response.
ASSISTANT_USE_MEMORY_CONTEXT=true
